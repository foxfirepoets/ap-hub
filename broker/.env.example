# Broker environment (CHUNK_2). On Render these are set in the dashboard, never git.
# Upstream keys are OPTIONAL until CHUNK_3 (proxy routes); auth + skeleton boot without them.

# Postgres — Render injects this in prod. Local scratch DB for tests:
DATABASE_URL=postgres://aphub:aphub@127.0.0.1:5432/aphub_broker

# Ben's upstream keys — Render environment ONLY. Leave blank locally.
ANTHROPIC_API_KEY=
SWARMSYNC_API_KEY=
SWARMSYNC_API_BASE=https://api.swarmsync.ai
SWARMSYNC_WEB_BASE=https://swarmsync.ai

LOG_LEVEL=info
PORT=8080
