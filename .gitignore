# Dependencies
node_modules/
.pnp
.pnp.js

# Build output. ANCHORED to the repository root: an unanchored `build/` also matches
# `docs/build/`, which silently excluded the build-coordination registries.
/dist/
/build/
*.tsbuildinfo

# Electron shell build + packaged installers (CHUNK_1_SHELL / CHUNK_9_PACKAGE)
dist-desktop/
release/
out/

# Environment & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
*.credentials.json

# Test / coverage
coverage/
.vitest/
*.log

# Local Postgres data (if run locally)
pgdata/

# Bundled PostgreSQL runtime (CHUNK_2_DATABASE). 120 MB of third-party binaries rebuilt by
# `node scripts/bundle-postgres.mjs`; the LOCK FILE is tracked so the pin and the expected
# tree fingerprint are reviewable, the binaries themselves are not.
vendor/pgsql/
vendor/.cache/
!vendor/postgres.lock.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Ralph loop runtime state (keep specs + prompts; ignore volatile logs)
.ralph/activity.log
.ralph/errors.log
.claude/cbv/

# Next.js / Playwright build artifacts (CHUNK_5)
.next/
next-env.d.ts
test-results/
playwright-report/
.vercel
.agents/
skills-lock.json
