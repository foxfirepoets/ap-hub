# ap-hub environment — copy to .env and fill in. NEVER commit .env.

# --- Core ---
DATABASE_URL=postgres://aphub:aphub@localhost:5432/aphub
ENCRYPTION_KEY=            # 32-byte hex; encrypts OAuth tokens at rest. Generate: openssl rand -hex 32

# --- LLM backend (all optional — src/llm/provider.ts auto-resolves in this order) ---
# 1. LLM_PROVIDER (explicit override): auto | anthropic | openai | ollama | lmstudio | custom | claude | codex | gemini
# 2. LLM_BASE_URL (any OpenAI-compatible endpoint: OpenRouter, Groq, vLLM, ...)
# 3. a running local runtime (Ollama :11434 / LM Studio :1234) — free, no key
# 4. ANTHROPIC_API_KEY (native PDF support)  5. OPENAI_API_KEY
# No key is required if a local runtime or CLI is available. See getExtractor() in src/extract/model.ts.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Gmail (READ-ONLY in all phases) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/oauth/gmail/callback
WATCHED_LABEL=AP-Inbox     # the Gmail label the poller watches

# --- QBO (READ-ONLY lists in P1; SANDBOX writes in P2) ---
QBO_ENV=sandbox            # MUST be 'sandbox' in Phase 1 & 2. 'production' is refused by code.
QBO_MINOR_VERSION=         # pin a tested Accounting API minorversion
QBO_SANDBOX_CLIENT_ID=
QBO_SANDBOX_CLIENT_SECRET=
QBO_SANDBOX_REALM_ID=
QBO_SANDBOX_COMPANY_NAME=  # expected CompanyInfo.CompanyName; confirm-realm refuses connect/write on mismatch
QBO_SANDBOX_REDIRECT_URI=http://localhost:3001/oauth/qbo/callback
# Production slots exist only so Phase 3 can add them; MUST be empty/unused now:
# QBO_PROD_CLIENT_ID=
# QBO_PROD_CLIENT_SECRET=
# QBO_PROD_REALM_ID=

# --- SwarmSync proof suite (Amendment A1) — optional; default is ON (existing behavior) ---
SWARMSYNC_ENABLED=true     # false disables InvoiceProof/Verify-API/AuditProof entirely (no outbound calls)
SWARMSYNC_OFF_MODE=review  # when disabled: review (cap at human review, safe default) | autopost (no fraud gate)
SWARMSYNC_API_BASE=https://api.swarmsync.ai    # Verify-API + AuditProof (POST /api/verify)
SWARMSYNC_WEB_BASE=https://swarmsync.ai        # InvoiceProof scan (POST /api/scan/invoices, no auth)
SWARMSYNC_API_KEY=         # ssk_live_... — required for Verify-API/AuditProof; NEVER logged (ssk_ prefix is redacted)

# --- Phase 0.5 gatekeeper (proof-gated forwarding relay) — white-label: ALL per-business values live here, never in code ---
GATEKEEPER_ENABLED=false   # true enables the gatekeep job; false = clean rollback (holds preserved)
QBO_FORWARDING_ADDRESS=    # this company's QBO capture address (…@qbodocs.com) — the ONLY address the relay can ever send to
TELEGRAM_BOT_TOKEN=        # Telegram bot for held-invoice alerts; NEVER logged (redacted)
TELEGRAM_CHAT_ID=          # chat that receives hold alerts for this tenant

# --- QuickBooks Desktop via Web Connector (opt-in) — talks to a REAL company file ---
QB_DESKTOP_ENABLED=false   # false = disabled entirely; the QBO REST writer (sandbox-only) is unaffected
QB_DESKTOP_MODE=readonly   # readonly | write — write requires an explicit enqueue too, never automatic
QBWC_USERNAME=aphub        # the login you enter when importing the generated .QWC into the Web Connector
QBWC_PASSWORD=             # required when QB_DESKTOP_ENABLED=true; NEVER logged

# --- Thresholds / gates ---
AUTO_THRESHOLD=0.9         # >= this + no blocking flags => eligible to post (sandbox, P2)
REVIEW_THRESHOLD=0.6       # below this => exception:low_confidence
AMOUNT_CEILING=            # proposals over this amount are held (never auto-created), even in sandbox

# --- Runtime ---
POLL_INTERVAL_SECONDS=180
PORT=3001
LOG_LEVEL=info
