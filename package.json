{
  "name": "ap-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Accountant Hub — human-supervised Gmail invoice and statement intake for supported QuickBooks editions",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "db:reset": "tsx src/db/migrate.ts reset",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:int": "vitest run --mode integration",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:noleak": "node scripts/lint-noleak.mjs",
    "verify": "npm run lint && npm run lint:noleak && npm run typecheck && npm test && npm run web:build && npm run test:ui-contract",
    "verify:live": "npm run test:int",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "web:dev": "next dev",
    "web:start": "next start -p 3000 -H 127.0.0.1",
    "web:build": "next build",
    "web:lint": "next lint",
    "e2e": "npm run test:ui-contract",
    "test:ui-contract": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "mupdf": "^1.28.0",
    "next": "^14.2.15",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
