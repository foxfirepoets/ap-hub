# GOOGLE_SSO_CLIENT_ID: Google OAuth client id for human SSO login
GOOGLE_SSO_CLIENT_ID=
# GOOGLE_SSO_CLIENT_SECRET: Google OAuth client secret (store in platform secret manager)
GOOGLE_SSO_CLIENT_SECRET=
# SESSION_COOKIE_SECRET: secret used to sign/hash session cookies
SESSION_COOKIE_SECRET=
# SESSION_TTL_HOURS: session lifetime in hours (default 12)
SESSION_TTL_HOURS=
# WEB_BASE_URL: public base URL of the Next.js app
WEB_BASE_URL=
# DATABASE_URL: Postgres connection string (existing)
DATABASE_URL=
# QBO_ENV: must be 'sandbox' — config hard-refuses 'production'
QBO_ENV=sandbox
