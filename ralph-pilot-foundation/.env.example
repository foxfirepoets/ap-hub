# ap-hub-pilot-foundation — env template (values blank; NEVER commit real secrets)
# Tests + migrations are DB-backed; vitest does NOT load .env — set DATABASE_URL in the shell.

# --- ap-hub (broker mode) ---
# BROKER_BASE_URL: https URL of the deployed broker (http://127.0.0.1 allowed only in tests)
BROKER_BASE_URL=
# BROKER_INSTALL_TOKEN: this install's aph_ bearer token (issued by the broker CLI)
BROKER_INSTALL_TOKEN=
# DATABASE_URL: local ap-hub Postgres (pilot uses the bundled private instance)
DATABASE_URL=

# --- ap-hub (direct mode only — dev box / existing tests; NOT on pilot machines) ---
# ANTHROPIC_API_KEY: optional in broker mode; used only for direct extraction
ANTHROPIC_API_KEY=
# SWARMSYNC_API_KEY: optional in broker mode; ssk_ key for direct proof calls
SWARMSYNC_API_KEY=

# --- broker service (broker/ — set these in the Render dashboard, never in git) ---
# ANTHROPIC_API_KEY: broker-held Claude key
# SWARMSYNC_API_KEY: broker-held ssk_ key
# SWARMSYNC_API_BASE: https://api.swarmsync.ai
# SWARMSYNC_WEB_BASE: https://swarmsync.ai
# DATABASE_URL: broker Postgres (auto-injected by Render)
# LOG_LEVEL: info
# PORT: auto-injected by Render
